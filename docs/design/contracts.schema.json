{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cadence-mcp:contracts:0.1",
  "title": "Proposed Cadence MCP common contracts (not full tools/list)",
  "oneOf": [
    {"$ref": "#/$defs/result"},
    {"$ref": "#/$defs/planInput"}
  ],
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 256},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "objectRef": {
      "type": "object", "additionalProperties": false,
      "required": ["objectId", "generation", "pageId"],
      "properties": {
        "objectId": {"$ref": "#/$defs/id"},
        "generation": {"type": "integer", "minimum": 1},
        "pageId": {"$ref": "#/$defs/id"},
        "designDefinitionId": {"$ref": "#/$defs/id"},
        "occurrencePath": {"type": "array", "items": {"$ref": "#/$defs/id"}}
      }
    },
    "diagnostic": {
      "type": "object", "additionalProperties": false,
      "required": ["code", "severity", "message"],
      "properties": {
        "code": {"$ref": "#/$defs/id"},
        "severity": {"enum": ["error", "warning", "info"]},
        "message": {"type": "string"},
        "objectRef": {"$ref": "#/$defs/objectRef"}
      }
    },
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["artifactId", "kind", "workspaceRelativePath", "sha256", "size", "producedByJob", "sourceFingerprint", "createdAt", "validationState"],
      "properties": {
        "artifactId": {"$ref": "#/$defs/id"},
        "kind": {"type": "string"},
        "workspaceRelativePath": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size": {"type": "integer", "minimum": 0},
        "producedByJob": {"$ref": "#/$defs/id"},
        "sourceFingerprint": {"$ref": "#/$defs/sha256"},
        "createdAt": {"type": "string", "format": "date-time"},
        "validationState": {"enum": ["unverified", "validated", "failed", "indeterminate"]}
      }
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["level", "backend", "complete", "coverage", "notChecked"],
      "properties": {
        "level": {"enum": ["documented", "file_present", "runtime_probed", "fixture_passed", "workflow_passed"]},
        "backend": {"type": "string"},
        "complete": {"type": "boolean"},
        "coverage": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "notChecked": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "error": {
      "type": "object", "additionalProperties": false,
      "required": ["code", "message", "phase", "retryable", "details", "recoveryAction"],
      "properties": {
        "code": {"$ref": "#/$defs/id"},
        "message": {"type": "string"},
        "phase": {"type": "string"},
        "retryable": {"type": "boolean"},
        "details": {"type": "object"},
        "recoveryAction": {"type": "string"}
      }
    },
    "result": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "requestId", "status", "data", "diagnostics", "artifacts", "evidence", "error"],
      "properties": {
        "schemaVersion": {"const": "1.0"},
        "requestId": {"$ref": "#/$defs/id"},
        "status": {"enum": ["succeeded", "accepted", "partial", "failed", "indeterminate"]},
        "data": {"type": "object"},
        "diagnostics": {"type": "array", "items": {"$ref": "#/$defs/diagnostic"}},
        "artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifact"}},
        "evidence": {"$ref": "#/$defs/evidence"},
        "error": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/error"}]}
      },
      "allOf": [
        {"if": {"properties": {"status": {"enum": ["succeeded", "accepted"]}}}, "then": {"properties": {"error": {"type": "null"}}}},
        {"if": {"properties": {"status": {"enum": ["failed", "indeterminate"]}}}, "then": {"properties": {"error": {"$ref": "#/$defs/error"}}}},
        {"if": {"properties": {"status": {"const": "accepted"}}}, "then": {"properties": {"data": {"required": ["jobId"], "properties": {"jobId": {"$ref": "#/$defs/id"}}}}}}
      ]
    },
    "renameReference": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "target", "expectedOldRef", "newRef"],
      "properties": {
        "type": {"const": "rename_reference"},
        "target": {"$ref": "#/$defs/objectRef"},
        "expectedOldRef": {"type": "string", "minLength": 1},
        "newRef": {"type": "string", "minLength": 1}
      }
    },
    "setProperty": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "target", "propertyName", "expectedOldValue", "newValue"],
      "properties": {
        "type": {"const": "set_property"},
        "target": {"$ref": "#/$defs/objectRef"},
        "propertyName": {"type": "string", "minLength": 1},
        "expectedOldValue": {"type": ["string", "null"]},
        "newValue": {"type": "string"}
      }
    },
    "planInput": {
      "type": "object", "additionalProperties": false,
      "required": ["sessionId", "baseSnapshotId", "operations", "standardsProfile"],
      "properties": {
        "sessionId": {"$ref": "#/$defs/id"},
        "baseSnapshotId": {"$ref": "#/$defs/id"},
        "standardsProfile": {"type": "string", "minLength": 1},
        "operations": {"type": "array", "minItems": 1, "maxItems": 1000, "items": {"oneOf": [{"$ref": "#/$defs/renameReference"}, {"$ref": "#/$defs/setProperty"}]}}
      }
    }
  }
}
